# Copy to /opt/flipper-backend/.env (mode 600). Never commit the real file.
# A long random shared secret the Android app must send as the X-API-Key header.
FLIPPER_API_KEY=change-me-to-a-long-random-string
FLIPPER_DATA_DIR=/opt/flipper-backend/data
FLIPPER_YTDLP=/opt/flipper-backend/venv/bin/yt-dlp
FLIPPER_JOB_TTL=7200
FLIPPER_MAX_CONCURRENT=3
FLIPPER_IMPERSONATE=chrome

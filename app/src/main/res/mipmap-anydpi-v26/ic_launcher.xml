<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      A dedicated monochrome layer (Android 13+ themed icons): the same silhouette in one flat
      colour. Reusing the coloured foreground here would ship its own tint into a layer the system
      is supposed to colour itself.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
